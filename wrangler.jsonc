{
	"name": "douyin-sparkflow",
	"main": "cloudflare/worker.ts",
	"compatibility_date": "2026-11-01",
	"workers_dev": true,
	"observability": {
		"enabled": true
	},
	"containers": [
		{
			"class_name": "SparkFlowRuntime",
			"scheduling_policy": "durable_object",
			"images": {
				"base": {
					"dockerfile": "./DouYinSparkFlow/Dockerfile.server",
					"build_context": "./DouYinSparkFlow"
				}
			}
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "RUNTIME",
				"class_name": "SparkFlowRuntime"
			}
		]
	},
	"exports": {
		"SparkFlowRuntime": {
			"type": "durable-object",
			"storage": "sqlite"
		}
	},
	"triggers": {
		"crons": ["*/5 * * * *"]
	}
}
